# Service configuration
NODE_ENV=development
GOV_LOG_LEVEL=INFO
GOV_SERVICE_NAME=fetcher
PORT=5904

# Internal service URLs
AUTHENTICATOR_SERVICE_URL=http://localhost:5900

# Database URIs
MONGO_URI=mongodb://localhost:27017/governify-next
REDIS_URI=redis://localhost:6379

# Redis settings
REDIS_ENABLED=true
REDIS_MAX_RETRIES=5
REDIS_RETRY_DELAY_MS=2000
REDIS_SLOW_RECONNECTION_MAX_RETRIES=10
REDIS_SLOW_RECONNECTION_STRATEGY=false
REDIS_RETRY_SLOW_DELAY_MS=10000

# JWT configuration
CLIENT_ID=fetcher
CLIENT_SECRET=fetcher_client_secret
JWT_SECRET=governify_next_secret_key
JWT_ISSUER=authenticator
JWT_AUDIENCE=governify-next

# Github token rotation
GITHUB_APP_ID
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"